# HTTP
HTTP_PORT=8080
HTTP_MODE=debug

# PostgreSQL
DB_URL=localhost
DB_PORT=5432
DB_NAME=app
DB_USERNAME=app
DB_PASSWORD=app

# Auth / IdP (optional for template demo auth)
AUTH_URL=https://idp.example.com/auth/realms/app/protocol/openid-connect
CLIENT_ID=app_client
CLIENT_SECRET=change-me

# External services
EXTERNAL_API_URL=https://api.example.com
